CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_EXFAT_FS=y
CONFIG_FORCE_FAST_CHARGE=y
# CONFIG_FPR_FPC is not set
# CONFIG_IKHEADERS is not set
CONFIG_LOCALVERSION="-Stormbreaker"
CONFIG_LOG_BUF_SHIFT=20
CONFIG_LOG_CPU_MAX_BUF_SHIFT=0
# CONFIG_MODULES is not set
CONFIG_OPPO_ARCH_FILE=y
CONFIG_OPPO_CALL_MODE_SUPPORT=y
CONFIG_OPPO_CHIP_SOC_NODE=y
CONFIG_OPPO_COMMON_SOFT=y
CONFIG_OPPO_DEVICE_IFNO=y
CONFIG_OPPO_FINGERPRINT=y
CONFIG_OPPO_SHIP_MODE_SUPPORT=y
CONFIG_OPPO_SHORT_USERSPACE=y
CONFIG_OPPO_SM6125Q_CHARGER=y
CONFIG_QCA_CLD_WLAN=y
# CONFIG_QCOM_CPUSS_DUMP is not set
# CONFIG_QCOM_MEMORY_DUMP_V2 is not set
# CONFIG_SDCARD_FS is not set
CONFIG_SUSPEND_SKIP_SYNC=y
# CONFIG_TOUCHSCREEN_HIMAX_CHIPSET is not set
CONFIG_TOUCHSCREEN_ILI9881H=y
CONFIG_TOUCHSCREEN_NT36525B=y
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM is not set
CONFIG_UNICODE=y
